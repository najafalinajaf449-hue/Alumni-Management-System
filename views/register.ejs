<%- include('partials/header') %>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow">
            <div class="card-header bg-success text-white text-center">
                <h2 class="h4 mb-0">Create Alumni Account</h2>
            </div>
            <div class="card-body">

                <% if (errors.length) { %>
                    <div class="alert alert-danger">
                        <ul class="mb-0">
                            <% errors.forEach(e => { %><li><%= e %></li><% }) %>
                        </ul>
                    </div>
                <% } %>

                <form action="/register" method="POST" enctype="multipart/form-data" class="needs-validation" novalidate>

                    <h3 class="h6 text-uppercase text-muted">Account</h3>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label for="full_name" class="form-label">Full Name *</label>
                            <input type="text" class="form-control" id="full_name" name="full_name" maxlength="100"
                                   value="<%= old.full_name || '' %>" required>
                        </div>
                        <div class="col-md-6">
                            <label for="email" class="form-label">Email *</label>
                            <input type="email" class="form-control" id="email" name="email" maxlength="150"
                                   value="<%= old.email || '' %>" required>
                        </div>
                        <div class="col-md-6">
                            <label for="password" class="form-label">Password * (min 6 characters)</label>
                            <input type="password" class="form-control" id="password" name="password" minlength="6" required>
                        </div>
                        <div class="col-md-6">
                            <label for="confirm_password" class="form-label">Confirm Password *</label>
                            <input type="password" class="form-control" id="confirm_password" name="confirm_password" required>
                            <div class="invalid-feedback">Passwords must match.</div>
                        </div>
                    </div>

                    <h3 class="h6 text-uppercase text-muted">Personal</h3>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label for="phone" class="form-label">Phone</label>
                            <input type="text" class="form-control" id="phone" name="phone" maxlength="100"
                                   value="<%= old.phone || '' %>">
                        </div>
                        <div class="col-md-6">
                            <label for="date_of_birth" class="form-label">Date of Birth</label>
                            <input type="date" class="form-control" id="date_of_birth" name="date_of_birth"
                                   value="<%= old.date_of_birth || '' %>">
                        </div>
                        <div class="col-12">
                            <label class="form-label d-block">Gender</label>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="gender" id="genderMale" value="Male"
                                       <%= old.gender === 'Male' ? 'checked' : '' %>>
                                <label class="form-check-label" for="genderMale">Male</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="gender" id="genderFemale" value="Female"
                                       <%= old.gender === 'Female' ? 'checked' : '' %>>
                                <label class="form-check-label" for="genderFemale">Female</label>
                            </div>
                        </div>
                    </div>

                    <h3 class="h6 text-uppercase text-muted">Education</h3>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label for="student_id" class="form-label">Student ID</label>
                            <input type="text" class="form-control" id="student_id" name="student_id" maxlength="100"
                                   value="<%= old.student_id || '' %>">
                        </div>
                        <div class="col-md-6">
                            <label for="degree" class="form-label">Degree</label>
                            <input type="text" class="form-control" id="degree" name="degree" maxlength="100"
                                   placeholder="e.g. BS Computer Science" value="<%= old.degree || '' %>">
                        </div>
                        <div class="col-md-6">
                            <label for="department" class="form-label">Department *</label>
                            <select class="form-select" id="department" name="department" required>
                                <option value="">Choose...</option>
                                <% departments.forEach(d => { %>
                                    <option value="<%= d %>" <%= old.department === d ? 'selected' : '' %>><%= d %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="graduation_year" class="form-label">Graduation Year *</label>
                            <input type="number" class="form-control" id="graduation_year" name="graduation_year"
                                   min="1950" max="<%= new Date().getFullYear() + 6 %>" placeholder="e.g. 2026"
                                   value="<%= old.graduation_year || '' %>" required>
                        </div>
                    </div>

                    <h3 class="h6 text-uppercase text-muted">Career &amp; Location</h3>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label for="current_job" class="form-label">Current Job</label>
                            <input type="text" class="form-control" id="current_job" name="current_job" maxlength="100"
                                   value="<%= old.current_job || '' %>">
                        </div>
                        <div class="col-md-6">
                            <label for="company" class="form-label">Company</label>
                            <input type="text" class="form-control" id="company" name="company" maxlength="100"
                                   value="<%= old.company || '' %>">
                        </div>
                        <div class="col-md-6">
                            <label for="city" class="form-label">City</label>
                            <input type="text" class="form-control" id="city" name="city" maxlength="100"
                                   value="<%= old.city || '' %>">
                        </div>
                        <div class="col-md-6">
                            <label for="country" class="form-label">Country</label>
                            <input type="text" class="form-control" id="country" name="country" maxlength="100"
                                   value="<%= old.country || '' %>">
                        </div>
                        <div class="col-12">
                            <label for="address" class="form-label">Address</label>
                            <textarea class="form-control" id="address" name="address" rows="2" maxlength="500"><%= old.address || '' %></textarea>
                        </div>
                    </div>

                    <h3 class="h6 text-uppercase text-muted">Profile Photo</h3>
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <img id="photoPreview" src="/img/default-avatar.svg" alt="Preview" class="avatar-md">
                        <div class="flex-grow-1">
                            <input type="file" class="form-control" id="profile_photo" name="profile_photo"
                                   accept="image/jpeg,image/png,image/webp,image/gif">
                            <div class="form-text">JPG, PNG, WEBP or GIF, max 2 MB.</div>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-success w-100">Register</button>
                </form>

                <p class="text-center mt-3 mb-0">Already have an account? <a href="/login">Login</a></p>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
