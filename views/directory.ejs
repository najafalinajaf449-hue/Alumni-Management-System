<%- include('partials/header') %>

<div class="card shadow-sm">
    <div class="card-body">
        <h1 class="h3 mb-4">Alumni Directory</h1>

        <!-- Search + filter (GET form, so the URL can be shared) -->
        <form action="/alumni" method="GET" class="row g-2 mb-4">
            <div class="col-md-6">
                <input type="text" name="q" class="form-control" placeholder="Search by name, job, company or city..."
                       value="<%= q %>">
            </div>
            <div class="col-md-4">
                <select name="dept" class="form-select">
                    <option value="">All departments</option>
                    <% departments.forEach(d => { %>
                        <option value="<%= d %>" <%= dept === d ? 'selected' : '' %>><%= d %></option>
                    <% }) %>
                </select>
            </div>
            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-primary">Search</button>
            </div>
        </form>

        <p class="text-muted small"><%= alumni.length %> result<%= alumni.length === 1 ? '' : 's' %> found.
            <% if (q || dept) { %><a href="/alumni">Clear filters</a><% } %></p>

        <div class="table-responsive">
            <table class="table table-striped table-bordered table-hover align-middle">
                <thead class="table-primary">
                    <tr>
                        <th>Name</th><th>Batch</th><th>Department</th><th>Job</th><th>City</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (alumni.length === 0) { %>
                        <tr><td colspan="5" class="text-center text-muted">No alumni match your search.</td></tr>
                    <% } %>
                    <% alumni.forEach(person => { %>
                        <tr>
                            <td>
                                <img src="<%= photoUrl(person.profile_photo) %>" alt="" class="avatar-xs me-2">
                                <a href="/alumni/<%= person.id %>"><%= person.full_name %></a>
                            </td>
                            <td><%= person.graduation_year || '-' %></td>
                            <td><%= person.department || '-' %></td>
                            <td>
                                <%= person.current_job || '-' %>
                                <% if (person.company) { %><span class="text-muted">@ <%= person.company %></span><% } %>
                            </td>
                            <td><%= person.city || '-' %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
