<%- include('partials/header') %>

<section class="mb-4">
    <h1 class="h2">Welcome Back, <%= currentUser.name %>!</h1>
    <p class="text-muted">Manage your alumni network from your dashboard.</p>
</section>

<!-- Stat cards (Lab 4, now real numbers from MySQL) -->
<section class="stats mb-5">
    <div class="stat-card"><h3>Total Alumni</h3><p><%= stats.total %></p></div>
    <div class="stat-card"><h3>Departments</h3><p><%= stats.departments %></p></div>
    <div class="stat-card"><h3>Cities</h3><p><%= stats.cities %></p></div>
    <div class="stat-card"><h3>New (30 days)</h3><p><%= stats.newMembers %></p></div>
</section>

<section class="card shadow-sm">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h4 mb-0">Recent Alumni</h2>
            <a href="/alumni" class="btn btn-sm btn-outline-primary">View all</a>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-primary">
                    <tr><th>Name</th><th>Batch</th><th>Department</th></tr>
                </thead>
                <tbody>
                    <% recent.forEach(person => { %>
                        <tr>
                            <td>
                                <img src="<%= photoUrl(person.profile_photo) %>" alt="" class="avatar-xs me-2">
                                <a href="/alumni/<%= person.id %>"><%= person.full_name %></a>
                            </td>
                            <td><%= person.graduation_year %></td>
                            <td><%= person.department %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</section>

<%- include('partials/footer') %>
